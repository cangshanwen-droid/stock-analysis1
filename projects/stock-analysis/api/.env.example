SQLITE_DB_PATH=../data/stock_analysis.db
# The app refuses to boot if CORS_ALLOW_ORIGINS is unset or contains a
# bare "*". Local frontend dev must append http://localhost:3000 explicitly.
CORS_ALLOW_ORIGINS=https://stock-analysis1-ten.vercel.app,https://www.gipfel.ltd,https://gipfel.ltd
# The app refuses to boot with the default/missing TOKEN_SECRET.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# TOKEN_SECRET=<generated value>
# Admin account recovery password. If unset, the recovery feature is
# disabled (no default password). Set a strong value to enable it.
# ADMIN_PASSWORD=<strong password>
TOKEN_TTL_SECONDS=28800
ENABLE_ORDER_WRITES=true
ENABLE_MARKET_WRITES=true
ENABLE_ADMIN_WRITES=true
# Future production value:
# DATABASE_URL=postgresql://user:password@host:5432/gipfel
